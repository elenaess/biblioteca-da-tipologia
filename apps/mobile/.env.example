EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WEB_URL=

# Google Sign-In nativo. Este precisa ser um OAuth Client ID do tipo WEB,
# porque ele vira o audience do idToken entregue ao Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Referência opcional para sua configuração no Google Cloud. O Android Client
# ID é vinculado a br.org.bibliotecadatipologia + SHA-1 da chave de assinatura.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
