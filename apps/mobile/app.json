{
  "expo": {
    "name": "Biblioteca da Tipologia",
    "slug": "biblioteca-da-tipologia",
    "version": "1.1.0",
    "scheme": [
      "bibliotecadatipologia",
      "bibliotecatipologia"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon.png",
    "android": {
      "package": "br.org.bibliotecadatipologia",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-foreground.png",
        "backgroundColor": "#f4eee4"
      }
    },
    "ios": {
      "bundleIdentifier": "com.elenabiblioteca.tipologia",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "@config-plugins/react-native-pdf",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto para o seu perfil na Biblioteca da Tipologia.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
