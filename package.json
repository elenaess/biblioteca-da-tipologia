{
  "name": "biblioteca-da-tipologia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @biblioteca/web",
    "build": "npm run build --workspace @biblioteca/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:start": "npm --prefix apps/mobile start",
    "seed:prepare": "node scripts/prepare-seed.mjs",
    "reader:bundle": "node scripts/build-mobile-reader.mjs",
    "images:manifest": "node scripts/generate-mobile-image-assets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dompurify": "^3.2.7",
    "fflate": "0.8.3",
    "lucide-react": "^0.577.0",
    "marked": "18.0.14",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
